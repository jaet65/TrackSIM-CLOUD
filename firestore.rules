rules_version = '2';

// Modelo de datos asumido:
//  - evaluaciones/{id}: { empresa: string, updatedAt: string(ISO), ... }
//  - conductores/{id}: { empresa: string, ... } (acceso a la empresa asignada)
//  - usuarios/{uid}: { role: 'viewer', empresaPermitida: string ('' | 'all' | nombre),
//                      empresasPermitidas: string[], email, ... } (asignación de empresa solo por admin)
//  - dominios_empresas/{dominio}: { empresa: string }  (dominio en minúsculas, ej. "cliente.com")
//  - configuracion/catalogo_ejercicios: catálogo compartido, legible por usuarios autenticados
//  - _eliminaciones/{id}: { empresa: string, deletedAt: string(ISO), ids?: string[], deleteAll?: boolean }
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador verificado (@corporativomaf.com)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email.lower().matches('.*@corporativomaf[.]com$') &&
             request.auth.token.email_verified == true;
    }

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function emailDomain() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email.matches('^[^@]+@[^@]+$')
        ? request.auth.token.email.lower().split('@')[1]
        : '';
    }

    function domainPath() {
      return /databases/$(database)/documents/dominios_empresas/$(emailDomain());
    }

    // Empresa asignada por dominio de correo (vacía si no hay mapeo)
    function domainEmpresa() {
      return (emailDomain() != '' && exists(domainPath()))
        ? get(domainPath()).data.get('empresa', '')
        : '';
    }

    // ¿El usuario puede leer datos de la empresa indicada?
    function canReadEmpresa(empresa) {
      return isAdmin() ||
             (signedIn() && (
               domainEmpresa() == 'all' ||
               domainEmpresa() == empresa ||
               (hasUserDoc() && (
                 userDoc().get('empresaPermitida', '') == 'all' ||
                 userDoc().get('empresaPermitida', '') == empresa ||
                 empresa in userDoc().get('empresasPermitidas', [])
               ))
             ));
    }

    // Evaluaciones: lectura solo de la(s) empresa(s) permitida(s), escritura solo admin
    match /evaluaciones/{evalId} {
      allow read: if canReadEmpresa(resource.data.empresa);
      allow write: if isAdmin();
    }

    // Fichas de conductores: lectura limitada a la empresa asignada, escritura para admin
    match /conductores/{conductorId} {
      allow read: if canReadEmpresa(resource.data.empresa);
      allow write: if isAdmin();
    }

    // Usuarios: cada usuario lee su perfil o admin lee todos.
    // Autoregistro solo como viewer, SIN asignarse empresas arbitrarias
    // (solo vacía o la derivada de su dominio de correo).
    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
                      signedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.role == 'viewer' &&
                      request.resource.data.get('empresaPermitida', '') in ['', domainEmpresa()] &&
                      request.resource.data.get('empresasPermitidas', []).size() <= 1 &&
                      (request.resource.data.get('empresasPermitidas', []).size() == 0 ||
                       request.resource.data.empresasPermitidas[0] == domainEmpresa())
                    );
      allow update, delete: if isAdmin();
    }

    // Mapeo de dominios a empresas
    match /dominios_empresas/{domainId} {
      allow read: if isAdmin() ||
                    (signedIn() && emailDomain() != '' && domainId == emailDomain());
      allow write: if isAdmin();
    }

    // Solo el catálogo usado por todos los usuarios es legible fuera del rol admin
    match /configuracion/{docId} {
      allow read: if isAdmin() || (signedIn() && docId == 'catalogo_ejercicios');
      allow write: if isAdmin();
    }

    // Bitácora de auditoría: eventos propios, inmutables y con fecha del servidor; lectura solo admin.
    // Cualquier usuario autenticado puede registrar accesos, lecturas/exportaciones y su autoregistro;
    // el resto de categorías (reportes, usuarios, seguridad) solo las registra un admin.
    function auditShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'categoria', 'accion', 'actorUid', 'actorEmail', 'fecha', 'detalle', 'empresas',
               'cantidad', 'metodo', 'critico', 'antes', 'despues', 'sesionId', 'navegador'
             ]) &&
             d.keys().hasAll(['categoria', 'accion', 'actorUid', 'actorEmail', 'fecha']) &&
             d.categoria is string && d.accion is string &&
             d.actorUid == request.auth.uid &&
             d.actorEmail == request.auth.token.email.lower() &&
             d.fecha == request.time &&
             d.get('detalle', '') is string && d.get('detalle', '').size() <= 500 &&
             d.get('empresas', []) is list && d.get('empresas', []).size() <= 20 &&
             d.get('cantidad', 0) is int &&
             d.get('metodo', '') is string && d.get('metodo', '').size() <= 40 &&
             d.get('critico', false) is bool &&
             d.get('antes', '') is string && d.get('antes', '').size() <= 1200 &&
             d.get('despues', '') is string && d.get('despues', '').size() <= 1200 &&
             d.get('sesionId', '') is string && d.get('sesionId', '').size() <= 64 &&
             d.get('navegador', '') is string && d.get('navegador', '').size() <= 250;
    }

    function auditSelfServiceOk() {
      let d = request.resource.data;
      return (d.categoria == 'acceso' && d.accion in ['login', 'logout']) ||
             (d.categoria == 'datos' && d.accion in ['ver', 'exportar', 'imprimir']) ||
             (d.categoria == 'seguridad' && d.accion == 'autoregistro');
    }

    match /auditoria/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
                      request.auth.token.email is string &&
                      auditShapeOk() &&
                      (auditSelfServiceOk() ||
                       (isAdmin() && request.resource.data.categoria in ['reporte', 'usuarios', 'seguridad']));
      allow update, delete: if false;
    }

    // Tombstones de sincronización incremental, limitados a las empresas permitidas
    match /_eliminaciones/{delId} {
      allow read: if canReadEmpresa(resource.data.empresa);
      allow write: if isAdmin();
    }
  }
}