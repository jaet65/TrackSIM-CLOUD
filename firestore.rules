rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Función para verificar si el usuario es Administrador (@corporativomaf.com)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.matches('.*@corporativomaf[.]com$');
    }

    // Evaluaciones: lectura para cualquier usuario autenticado, escritura exclusiva para administradores
    match /evaluaciones/{evalId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Fichas de conductores
    match /conductores/{conductorId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Registro de usuarios gestionados por administradores
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Mapeo automático de dominios a empresas
    match /dominios_empresas/{domainId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}