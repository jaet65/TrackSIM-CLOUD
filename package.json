{
  "name": "tracksim-cloud",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "capture:demo": "node scripts/capture-demo-video.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "tsc --noEmit && oxlint",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:staging": "vite build && firebase hosting:channel:deploy staging",
    "test": "tsc --noEmit && firebase emulators:exec --only firestore --project demo-tracksim-cloud \"vitest run\"",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.5.1",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
