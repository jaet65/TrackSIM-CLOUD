{
  "name": "tracksim-cloud",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "capture:demo": "node scripts/capture-demo-video.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "tsc --noEmit && biome lint .",
    "build": "vitest run --exclude src/services/__tests__/firestoreSecurity.test.ts && vite build",
    "preview": "vite preview",
    "deploy:staging": "vite build && firebase hosting:channel:deploy staging",
    "test": "tsc --noEmit && vitest run --exclude src/services/__tests__/firestoreSecurity.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tracksim-cloud \"vitest run src/services/__tests__/firestoreSecurity.test.ts\"",
    "test:all": "npm test && npm run test:rules",
    "test:watch": "vitest --exclude src/services/__tests__/firestoreSecurity.test.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.5.1",
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
